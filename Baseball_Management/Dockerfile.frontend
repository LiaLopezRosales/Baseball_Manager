# Dockerfile — Frontend React 18 (CRA)
# Se usa con docker-compose (ver docker-compose.yml en la raíz del repo).
# Arranca el dev server de CRA accesible desde el host en :3000.
# REACT_APP_API_URL se inyecta vía env (build-time) → apuntar a http://localhost:8000
FROM node:22-slim

ENV NODE_ENV=development \
    CI=false

WORKDIR /app

# deps primero (mejor caché de capas)
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# código del frontend
COPY . .

EXPOSE 3000

# CRA necesita escuchar en 0.0.0.0 dentro del container y que el browser del
# host alcance el backend publicado en localhost:8000.
ENV REACT_APP_API_URL=http://localhost:8000

CMD ["npx", "react-scripts", "start", "--host", "0.0.0.0"]