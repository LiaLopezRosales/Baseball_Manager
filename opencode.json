{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google": {
      "options": {
        "apiKey": "{file:~/.secrets/google-gemini.key}"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless",
        "--no-sandbox",
        "--allowed-hosts",
        "localhost,127.0.0.1,*.localhost"
      ],
      "enabled": true,
      "environment": {
        "BROWSER": "chromium"
      }
    }
  }
}
